# ─────────────────────────────────────────────────────────────────────────────
# Keerthan's Pi — Runtime Environment Variables
# Source this file before starting the app:
#   source config/pi_config.env
#   python ../../src/web_app.py --host 0.0.0.0 --port 5001
# ─────────────────────────────────────────────────────────────────────────────

# ── Model paths (relative to repo root / absolute) ───────────────────────────
export ECOSORT_CUSTOM_MODEL="$(pwd)/../../src/yolo/weights/ecosort_waste_yolo11s.onnx"
export ECOSORT_ONNX_ONLY="1"           # Skip specialist .pt models (saves ~160 MB)

# ── Llama / LLM ──────────────────────────────────────────────────────────────
# GGUF model (download via scripts/download_llama.sh)
export LLAMA_GGUF_PATH="$(pwd)/models/llama-3.2-1b-instruct-q4_k_m.gguf"

# ExecuTorch .pte (optional — see docs/EXECUTORCH_SETUP.md)
# export LLAMA_PTE_PATH="$(pwd)/models/llama3_2_1b.pte"
# export LLAMA_TOKENIZER_PATH="$(pwd)/models/tokenizer.model"
# export LLAMA_BACKEND="executorch"

# Default backend: auto (tries executorch, falls back to gguf, then rule-engine)
export LLAMA_BACKEND="gguf"

# ── Flask App ─────────────────────────────────────────────────────────────────
export PYTHONPATH="$(pwd)/../../src"
export FLASK_ENV="production"
export PORT="5001"
export ENABLE_SAHI="false"             # Disable SAHI — saves CPU cycles on Pi

# ── Database & Storage ───────────────────────────────────────────────────────
export WASTE_DB_PATH="$(pwd)/database/waste_data.db"
export WASTE_REPORTS_PATH="$(pwd)/reports"
export WASTE_LOG_PATH="$(pwd)/logs/waste_system.log"

# ── Serial (Pico W sensors) ───────────────────────────────────────────────────
export SERIAL_PORT="/dev/ttyACM0"
export SERIAL_BAUDRATE="115200"
